[
  {
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight",
    },
  },
  // VIM Normal & Visual
  {
    "context": "VimControl && !menu",
    "bindings": {
      "shift k": "editor::Hover",
      "space a a": "agent::ToggleFocus",
      "space e": "project_panel::ToggleFocus",
      "space space": "file_finder::Toggle",
      "space u h": "editor::ToggleInlayHints",

      // Git
      "space g g": "git_panel::Toggle",
      "space g b": "git::Blame",
      "space g d": "editor::ToggleSelectedDiffHunks",
      "space g h r": "git::Restore",

      // Panes (i.e. Buffers)
      "space q": "workspace::CloseInactiveTabsAndPanes",
      "space Q": "workspace::CloseAllItemsAndPanes",
    },
  },
  {
    "context": "AgentPanel",
    "bindings": {
      "space a a": "workspace::ToggleRightDock",
      // "space e": "project_panel::ToggleFocus",
    },
  },
  {
    "context": "ProjectPanel",
    "bindings": {
      "space a a": "agent::ToggleFocus",
      "space e": "workspace::ToggleRightDock",
    },
  },
  {
    "context": "GitPanel",
    "bindings": {
      "space g g": "workspace::ToggleLeftDock",
    },
  },
  {
    "context": "EmptyPane",
    "bindings": {
      "space a a": "agent::ToggleFocus",
      // "space e": "project_panel::ToggleFocus",
      "space g g": "workspace::ToggleLeftDock",
      "space space": "file_finder::Toggle",
    },
  },
]
